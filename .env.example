# ==============================================================================
# Database Configuration
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=FlatNFlatmates
MONGODB_DB=flatnflatmates_dev

# Environment: 'development' | 'production'
ENVIRONMENT=development

# ==============================================================================
# NextAuth Authentication
# ==============================================================================
NEXTAUTH_SECRET=your_random_secret_string
NEXTAUTH_URL=http://localhost:3000

# ==============================================================================
# Google OAuth (Sign in with Google)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# Amazon S3 Object Storage & Media Processing
# ==============================================================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Internal webhook shared secret between AWS Lambda and Next.js backend
INTERNAL_MEDIA_SECRET=your_internal_media_secret_token

# ==============================================================================
# MSG91 SMS & Telephony Service
# ==============================================================================
# Options: 'msg91' (Live SMS) | 'mock' (Local development log)
TELEPHONY_PROVIDER=mock

# MSG91 Credentials
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_SMS_TEMPLATE_ID=69ad234857b29a1b1b1b22e1
MSG91_INTEREST_FLOW_ID=69ad234857b29a1b1b1b22e1
MSG91_SENDER_ID=FLTNFL

# MSG91 Client-Side OTP Web SDK (exposeMethods: true)
NEXT_PUBLIC_MSG91_WIDGET_ID=366967734164383234373932
NEXT_PUBLIC_MSG91_TOKEN_AUTH=568741T1kJ2zjXdR6a9efcf2P1


# ==============================================================================
# Cloudflare Turnstile Invisible Bot Protection (Optional for Dev, Recommended for Prod)
# ==============================================================================
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# ==============================================================================
# Google Maps API Key
# ==============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ==============================================================================
# Property Collector Platform URL
# ==============================================================================
NEXT_PUBLIC_PROPERTY_COLLECTOR_URL=https://property-collector.example.com
PROPERTY_COLLECTOR_URL=https://property-collector.example.com

